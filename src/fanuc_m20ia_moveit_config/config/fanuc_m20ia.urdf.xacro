<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fanuc_m20ia">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import fanuc_m20ia urdf file -->
    <xacro:include filename="$(find fanuc_m20ia_description)/urdf/m20ia.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="fanuc_m20ia.ros2_control.xacro" />


    <xacro:fanuc_m20ia_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
