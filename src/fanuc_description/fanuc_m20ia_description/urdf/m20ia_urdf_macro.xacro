<!-- URDF macro matching urdf/m20ia.urdf for FANUC M-20iA -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro
    name="m20ia"
    params="prefix=''
            parent
            *origin
            child"
  >

    <!-- links: main serial chain -->
    <link name="${prefix}base_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/visual/base_link.stl" />
        </geometry>
        <material name="">
          <color rgba="0.2784313725490196 0.2784313725490196 0.2784313725490196 1.0" />
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/collision/base_link.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 32.5" />
        <origin xyz="-.0269 -.0000215  .157" />
        <inertia
          ixx=" .556"
          ixy="-.00546"
          ixz="-.00524"
          iyy=" .681"
          iyz="-.000569"
          izz=" .667"
        />
      </inertial>
    </link>

    <link name="${prefix}link_1">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/visual/link_1.stl" />
        </geometry>
        <material name="">
          <color rgba="0.96 0.76 0.13 1.0" />
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/collision/link_1.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 52.3" />
        <origin xyz=" .0372  .00108 -.101" />
        <inertia
          ixx=" 1.85"
          ixy="-.00339"
          ixz="-.149"
          iyy=" 1.15"
          iyz="-.00387"
          izz=" 1.52"
        />
      </inertial>
    </link>

    <link name="${prefix}link_2">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/visual/link_2.stl" />
        </geometry>
        <material name="">
          <color rgba="0.96 0.76 0.13 1.0" />
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/collision/link_2.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 92.7" />
        <origin xyz="-.0012 -.000625  .461" />
        <inertia
          ixx=" 10.7"
          ixy="-.00108"
          ixz=" .00167"
          iyy=" 10"
          iyz=" .00496"
          izz=" 1.7"
        />
      </inertial>
    </link>

    <link name="${prefix}link_3">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/visual/link_3.stl" />
        </geometry>
        <material name="">
          <color rgba="0.96 0.76 0.13 1.0" />
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/collision/link_3.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 17.2" />
        <origin xyz=" .0221 -.00161  .0386" />
        <inertia
          ixx=" .21"
          ixy="-.00523"
          ixz="-.0224"
          iyy=" .233"
          iyz="-.00207"
          izz=" .205"
        />
      </inertial>
    </link>

    <link name="${prefix}link_4">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/visual/link_4.stl" />
        </geometry>
        <material name="">
          <color rgba="0.96 0.76 0.13 1.0" />
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/collision/link_4.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 14.2" />
        <origin xyz=" .524  .00617 -.0000045" />
        <inertia
          ixx=" .0578"
          ixy=" .00266"
          ixz="-.00000254"
          iyy=" .638"
          iyz=" .00000567"
          izz=" .654"
        />
      </inertial>
    </link>

    <link name="${prefix}link_5">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/visual/link_5.stl" />
        </geometry>
        <material name="">
          <color rgba="0.96 0.76 0.13 1.0" />
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/collision/link_5.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 1.12" />
        <origin xyz=" .0173  .00272  .0000418" />
        <inertia
          ixx=" .00181"
          ixy=" .0000283"
          ixz=" .000000144"
          iyy=" .00267"
          iyz="-.00000051"
          izz=" .00259"
        />
      </inertial>
    </link>

    <link name="${prefix}link_6">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/visual/link_6.stl" />
        </geometry>
        <material name="">
          <color rgba="0.15 0.15 0.15 1.0" />
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20ia_description/meshes/m20ia/collision/link_6.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value=" .024" />
        <origin xyz=" .0936 -3.11E-18  2.17E-17" />
        <inertia
          ixx=" .00000962"
          ixy=" 1.75E-20"
          ixz=" 9.56E-20"
          iyy=" .00000508"
          iyz="-3.95E-21"
          izz=" .00000508"
        />
      </inertial>
    </link>

    <!-- joints: main serial chain -->
    <joint name="${prefix}joint_1" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0.525" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}link_1" />
      <axis xyz="0 0 1" />
      <limit effort="4000" lower="-2.967060" upper="2.967060" velocity="3.403392" />
    </joint>

    <joint name="${prefix}joint_2" type="revolute">
      <origin rpy="0 0 0" xyz="0.150 0 0" />
      <parent link="${prefix}link_1" />
      <child link="${prefix}link_2" />
      <axis xyz="0 1 0" />
      <limit effort="7000" lower="-1.745329" upper="2.792527" velocity="3.054326" />
    </joint>

    <joint name="${prefix}joint_3" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0.790" />
      <parent link="${prefix}link_2" />
      <child link="${prefix}link_3" />
      <axis xyz="0 -1 0" />
      <limit effort="2000" lower="-3.228859" upper="4.766843" velocity="3.141593" />
    </joint>

    <joint name="${prefix}joint_4" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0.150" />
      <parent link="${prefix}link_3" />
      <child link="${prefix}link_4" />
      <axis xyz="-1 0 0" />
      <limit effort="500" lower="-3.490658" upper="3.490658" velocity="6.283185" />
    </joint>

    <joint name="${prefix}joint_5" type="revolute">
      <origin rpy="0 0 0" xyz="0.860 0 0" />
      <parent link="${prefix}link_4" />
      <child link="${prefix}link_5" />
      <axis xyz="0 -1 0" />
      <limit effort="300" lower="-2.443461" upper="2.443461" velocity="6.283185" />
    </joint>

    <joint name="${prefix}joint_6" type="revolute">
      <origin rpy="0 0 0" xyz="0.100 0 0" />
      <parent link="${prefix}link_5" />
      <child link="${prefix}link_6" />
      <axis xyz="-1 0 0" />
      <limit effort="200" lower="-4.712389" upper="4.712389" velocity="9.599311" />
    </joint>

    <!-- ROS-Industrial 'base' frame: base_link to Fanuc World Coordinates transform -->
    <link name="${prefix}base" />
    <joint name="${prefix}base_link-base" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0.525" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}base" />
    </joint>

    <!-- ROS-Industrial 'flange' frame: attachment point for EEF models -->
    <link name="${prefix}flange" />
    <joint name="${prefix}joint_6-flange" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <parent link="${prefix}link_6" />
      <child link="${prefix}flange" />
    </joint>

    <!-- ROS-Industrial 'tool0' frame: all-zeros tool frame -->
    <link name="${prefix}tool0" />
    <joint name="${prefix}link_6-tool0" type="fixed">
      <origin rpy="3.141592653589793 -1.5707963267948966 0" xyz="0 0 0" />
      <parent link="${prefix}flange" />
      <child link="${prefix}tool0" />
    </joint>

    <!-- Attach to parent -->
    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}base_link" />
    </joint>

    <!-- Attach child -->
    <joint name="${prefix}child_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${prefix}tool0" />
      <child link="${child}" />
    </joint>
  </xacro:macro>
</robot>
